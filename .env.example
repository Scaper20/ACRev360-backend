DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgres://acrev360:changeme@localhost:5432/acrev360
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=https://app.example.com
WEBHOOK_STRICT_SIGNATURES=True
WEBHOOK_ENCRYPTION_KEY=generate-with-Fernet.generate_key
# True in a real deploy behind a TLS-terminating proxy (nginx/ALB). Set False
# for this repo's docker-compose.yml, which has no such proxy in front of
# gunicorn.
DJANGO_SECURE_SSL_REDIRECT=True
